{
  "name": "handall-root",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix frontend install && npm --prefix backend install && powershell -ExecutionPolicy Bypass -File scripts\\setup-ai.ps1",
    "dev": "concurrently -n \"API,WEB,AI\" -c \"blue,green,magenta\" \"npm run dev:api\" \"npm run dev:web:wait\" \"npm run dev:ai\"",
    "dev:web:wait": "wait-on -t 120000 http://127.0.0.1:3001 && npm run dev:web",
    "build": "npm --prefix frontend run build",
    "serve": "npm --prefix backend start",
    "start": "npm run dev",
    "dev:api": "npm --prefix backend start",
    "dev:web": "npm --prefix frontend run dev",
    "dev:ai": "powershell -ExecutionPolicy Bypass -File scripts\\start-ai.ps1",
    "install-all": "npm run setup",
    "start:backend": "npm run dev:api",
    "start:frontend": "npm run dev:web",
    "start:ai": "npm run dev:ai"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^8.0.1"
  }
}
